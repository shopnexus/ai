# ai-models' settings that are the same in every stack, in the cluster and in
# the umbrella's docker-compose.yml (README, Configuration). The chart adds
# them to ai-models' env; compose reads this file with env_file from the
# submodule. AI_EMBED_MODELS differs, so it stays in values.yaml and in
# compose's x-ai-models block, and the chart fails on it here. Format:
# KEY=value, one per line, no quotes; an empty value is a setting.

AI_ADDR=:8000
AI_STT_MODELS=gipformer-1.5=/models/gipformer-1.5
AI_VAD_MODEL=/models/silero_vad.onnx
AI_NUM_THREADS=4
AI_MAX_CONCURRENT=2
AI_MAX_UPLOAD_MB=100
AI_MAX_AUDIO_SECONDS=300
AI_EMBED_MAX_INPUTS=16
AI_EMBED_MAX_CONCURRENT=2
AI_EMBED_MAX_IMAGE_MB=10
AI_FRAMES_MAX_CONCURRENT=2
AI_FRAMES_MAX_SECONDS=35
AI_FRAMES_MIN_SHARPNESS=30
